@model KullaniciListeModel
@{
    ViewData["Title"] = "Kullanıcılar";
    var benimId = User.KullaniciId();
}

<div class="sayfa-baslik">
    <div>
        <div class="yol">Yönetim › Kullanıcılar</div>
        <h1 tabindex="-1">Kullanıcılar ve roller</h1>
        <p>5 rol: Admin, Yönetici, Kalite, Operatör, Depo / Bakım. Şifreler hash'lenerek saklanır.</p>
    </div>
</div>

<div class="yan-yana">
    <section class="kart genis">
        <div class="tablo-kutu">
            <table class="tablo genis-tablo">
                <thead><tr><th>Kullanıcı</th><th>Rol</th><th>Son giriş</th><th>Durum</th><th>İşlemler</th></tr></thead>
                <tbody>
                    @foreach (var k in Model.Kullanicilar)
                    {
                        var kilitli = k.KilitBitis > DateTime.Now;
                        <tr>
                            <td>
                                <div class="esnek">
                                    <span class="avatar" style="width:34px;height:34px;font-size:13px">@(string.Concat(k.AdSoyad.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(x => x[0])))</span>
                                    <span><strong>@k.AdSoyad</strong><br /><small class="mono renk-soluk">@k.KullaniciAdi</small></span>
                                </div>
                            </td>
                            <td>
                                <form method="post" asp-action="RolDegistir" asp-route-id="@k.Id" class="esnek">
                                    <select name="rol" class="girdi" style="height:34px;width:auto" onchange="this.form.submit()" disabled="@(k.Id == benimId ? "disabled" : null)" aria-label="Rol">
                                        @foreach (var r in Roller.Tumu)
                                        {
                                            <option value="@r" selected="@(r == k.Rol ? "selected" : null)">@Roller.Ad(r)</option>
                                        }
                                    </select>
                                </form>
                            </td>
                            <td>@(k.SonGiris?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                            <td>
                                @if (!k.Aktif)
                                {
                                    <span class="rozet">Pasif</span>
                                }
                                else if (kilitli)
                                {
                                    <span class="rozet kirmizi">@Ikon.Ciz("kilit", 12) Kilitli</span>
                                }
                                else
                                {
                                    <span class="rozet yesil"><span class="nokta"></span>Aktif</span>
                                }
                            </td>
                            <td>
                                <div class="esnek">
                                    @if (k.Id != benimId)
                                    {
                                        <form method="post" asp-action="AktifDegistir" asp-route-id="@k.Id">
                                            <button type="submit" class="buton ikincil kucuk">@(k.Aktif ? "Pasif yap" : "Aktif et")</button>
                                        </form>
                                    }
                                    <details>
                                        <summary class="buton ikincil kucuk">Şifre</summary>
                                        <form method="post" asp-action="SifreSifirla" asp-route-id="@k.Id" class="esnek mt">
                                            <input name="sifre" type="password" class="girdi" style="height:34px;width:180px" placeholder="Yeni şifre" aria-label="Yeni şifre" />
                                            <button type="submit" class="buton birincil kucuk">Kaydet</button>
                                        </form>
                                    </details>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <aside class="dar">
        <section class="kart">
            <div class="kart-baslik"><h2>@Ikon.Ciz("arti") Yeni kullanıcı</h2></div>
            <form method="post" asp-action="KullaniciEkle" class="form-dikey">
                <label class="alan">Ad soyad <input name="adSoyad" class="girdi" required /></label>
                <label class="alan">Kullanıcı adı <input name="kullaniciAdi" class="girdi mono" autocapitalize="off" required /></label>
                <label class="alan">Rol
                    <select name="rol" class="girdi">
                        @foreach (var r in Roller.Tumu)
                        {
                            <option value="@r">@Roller.Ad(r)</option>
                        }
                    </select>
                </label>
                <label class="alan">Şifre <input name="sifre" type="password" class="girdi" required /></label>
                <small class="renk-soluk">En az 8 karakter; büyük harf, küçük harf ve rakam.</small>
                <button type="submit" class="buton bakir">@Ikon.Ciz("arti", 16) Kullanıcı ekle</button>
            </form>
        </section>
    </aside>
</div>
